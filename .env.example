# Shopify Admin API — SERVER-SIDE ONLY (never prefix with NEXT_PUBLIC_)
#
# Setup: Shopify admin → Settings → Apps → Develop apps → Create an app.
#   Admin API scopes: read_orders (required), read_customers (optional, for customer name).
#   Install the app, then copy the Admin API access token (starts with shpat_).
#
# Add these in Vercel → Settings → Environment Variables (Production/Preview/Development),
# and copy this file to `.env.local` for local development.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-04

# OpenAI — SERVER-SIDE ONLY. Powers the AI-tailored diagnosis at the end of the
# flow. If unset, the app falls back to the deterministic diagnoses (no error).
#   OPENAI_MODEL: any chat model that supports JSON mode (e.g. gpt-4o, gpt-4.1,
#   gpt-4o-mini). Set it to match your CS agent's model. Defaults to gpt-4o.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Proline support API (Stopgap) — SERVER-SIDE ONLY. Opens a support case when an
# agent submits at the end of the flow. Never expose this key to the browser.
PROLINE_SUPPORT_API_KEY=your-stopgap-api-key
# Optional — defaults to the production Stopgap endpoint if unset:
# PROLINE_SUPPORT_API_URL=https://stopgap.azurewebsites.net/api/PublicSupport/SubmitCase

# ---------------------------------------------------------------------------
# Storefront embedding (Shopify App Proxy) — see SHOPIFY-SETUP.md
#
# All three are OPTIONAL. Leave them unset and the app behaves exactly as it
# does today (agent console at /, customer flow at /customer, same-origin).
# Set them to serve the customer flow at prolinerangehoods.com/tools/troubleshoot.
# ---------------------------------------------------------------------------

# This app's own absolute origin. Makes the browser load static assets and call
# API routes here rather than against the storefront domain it's embedded in.
# NEXT_PUBLIC_ because it must reach the browser — it is a public URL, not a secret.
# NOTE: read at BUILD time (assetPrefix) — redeploy after changing it.
# NEXT_PUBLIC_APP_ORIGIN=https://proline-troubleshooting.vercel.app

# Origins allowed to call this app's API routes cross-origin. Comma-separated.
# Without this, storefront-embedded submissions are blocked by the browser.
# STOREFRONT_ORIGINS=https://prolinerangehoods.com,https://www.prolinerangehoods.com

# The Shopify app's client secret — SERVER-SIDE ONLY. Used to verify that a
# proxied request genuinely came from Shopify (HMAC on the query string).
# Once set, a request presenting a bad signature 404s. Unsigned requests still
# work so the Vercel URL stays usable for internal QA.
# SHOPIFY_APP_PROXY_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
